# Copy to .env and fill in the two API keys.

# https://console.groq.com/keys
GROQ_API_KEY=
# Check https://console.groq.com/docs/deprecations before changing models.
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
# low | medium | high
GROQ_ANSWER_REASONING_EFFORT=medium
# Used instead for plain look-up questions ("what is X?"): a faster first word.
GROQ_ANSWER_SIMPLE_REASONING_EFFORT=low
# Answers with this model at once when the answer model is rate-limited or overloaded (Groq's
# free tier: 8,000 tokens/minute per model, shared by all students). Empty = wait instead.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_FAST_REASONING_EFFORT=low

# https://app.pinecone.io  (the index is created automatically: 384 dims, cosine, serverless)
PINECONE_API_KEY=
PINECONE_INDEX=education-app
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Use a long random string in production.
JWT_SECRET=change-me-in-production

# Admin accounts (comma-separated emails): they add books to the shared library, which every user
# can ask about, and have no daily limits. Sign up with this email to become an admin.
ADMIN_EMAILS=
# Keep the database copy of every upload after it's processed (false deletes it to save space).
KEEP_FILE_COPIES=false

# Local (non-Docker) development only; docker-compose overrides these.
DATABASE_URL=mysql+aiomysql://edu:edu@localhost:3306/edu?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./data/uploads
INGEST_MODE=queue

MAX_QUESTIONS_PER_SECTION=30
# Daily per-user limits (reset at midnight UTC; 0 = unlimited). These cap LLM cost per user,
# since the per-chat limit alone can be bypassed by opening more chats.
DAILY_QUESTION_LIMIT=100
DAILY_QUIZ_LIMIT=20
DAILY_UPLOAD_LIMIT=30
DAILY_CHAT_LIMIT=20
RATE_LIMIT_PER_MINUTE=20
# Signing up and in (0 = no limit). Per IP (Cloudflare's client-IP header on Render), plus an
# app-wide sign-up cap and a per-account login cap that hold even when IPs are faked.
SIGNUP_LIMIT_PER_IP_PER_HOUR=5
SIGNUP_LIMIT_PER_HOUR=100
LOGIN_LIMIT_PER_IP_PER_15MIN=30
LOGIN_LIMIT_PER_EMAIL_PER_15MIN=10

# Hybrid retrieval: BM25 keyword search + vector search merged with reciprocal rank fusion.
HYBRID_SEARCH=true
RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=12

# Multilingual embeddings (50+ languages incl. Hindi). Changing this re-embeds documents at startup.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Chunk size in the embedding model's tokens (the multilingual model reads at most 128).
CHUNK_TOKENS=120
CHUNK_OVERLAP_TOKENS=20

# OCR for photos and scanned PDF pages (Tesseract language packs: eng, hin, ...).
OCR_LANGUAGES=eng+hin
OCR_MAX_PAGES=40

# Figures (diagrams, charts, photos) from uploads, described by a Groq vision model and shown in answers.
FIGURES_ENABLED=true
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional second vision provider, used when Groq's daily limit is reached (free key from
# https://aistudio.google.com/apikey). Work neither can take now is retried every few minutes.
GEMINI_API_KEY=
# Tried in order; on the free tier each model has its own daily limit, so more models = more capacity.
GEMINI_VISION_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
VISION_RETRY_MINUTES=10
MAX_FIGURES_PER_DOCUMENT=30
DAILY_FIGURE_LIMIT=150
# Math-heavy PDF pages are read again from a picture by the vision model, with math in LaTeX.
MATH_VISION_ENABLED=true
MATH_VISION_MAX_PAGES=40
DAILY_MATH_PAGE_LIMIT=300
# Pictures from the web in answers: Wikipedia images (free, no key) and, with a Serper.dev key,
# Google Images (only when the student asks for a picture). Searched alongside the documents and
# dropped if slower than WEB_IMAGE_TIMEOUT seconds, so answers are never delayed.
WEB_IMAGES_ENABLED=true
SERPER_API_KEY=
WEB_IMAGE_TIMEOUT=0.8
