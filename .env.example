# Copy to .env and fill in the two API keys.

# https://console.groq.com/keys
GROQ_API_KEY=
# Check https://console.groq.com/docs/deprecations before changing models.
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
# low | medium | high
GROQ_ANSWER_REASONING_EFFORT=medium
GROQ_FAST_REASONING_EFFORT=low

# https://app.pinecone.io  (the index is created automatically: 384 dims, cosine, serverless)
PINECONE_API_KEY=
PINECONE_INDEX=education-app
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Use a long random string in production.
JWT_SECRET=change-me-in-production

# Local (non-Docker) development only; docker-compose overrides these.
DATABASE_URL=mysql+aiomysql://edu:edu@localhost:3306/edu?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./data/uploads
INGEST_MODE=queue

MAX_QUESTIONS_PER_SECTION=30
# Daily per-user limits (reset at midnight UTC; 0 = unlimited). These cap LLM cost per user,
# since the per-chat limit alone can be bypassed by opening more chats.
DAILY_QUESTION_LIMIT=100
DAILY_QUIZ_LIMIT=20
DAILY_UPLOAD_LIMIT=30
DAILY_CHAT_LIMIT=20
RATE_LIMIT_PER_MINUTE=20

# Hybrid retrieval: BM25 keyword search + vector search merged with reciprocal rank fusion.
HYBRID_SEARCH=true
RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=12

# Multilingual embeddings (50+ languages incl. Hindi). Changing this re-embeds documents at startup.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Chunk size in the embedding model's tokens (the multilingual model reads at most 128).
CHUNK_TOKENS=120
CHUNK_OVERLAP_TOKENS=20

# OCR for photos and scanned PDF pages (Tesseract language packs: eng, hin, ...).
OCR_LANGUAGES=eng+hin
OCR_MAX_PAGES=40

# Figures (diagrams, charts, photos) from uploads, described by a Groq vision model and shown in answers.
FIGURES_ENABLED=true
GROQ_VISION_MODEL=qwen/qwen3.8-27b
MAX_FIGURES_PER_DOCUMENT=30
DAILY_FIGURE_LIMIT=150
# Cloudflare R2 bucket for figure images (S3-compatible, free tier). Leave empty to keep them on
# local disk (fine locally; wiped on every restart on hosts like Render).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
